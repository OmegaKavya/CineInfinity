# Copy to .env and fill in. Vite only exposes VITE_ prefixed variables to the
# browser, which is what keeps server-side secrets out of the bundle.

# Where the API lives. No fallback on purpose: a missing value fails at
# startup rather than silently writing to the production database.
VITE_API_BASE_URL=http://localhost:5001

# Firebase web config, from Project settings, General, Your apps.
# These are identifiers, not secrets: they ship in the bundle to every
# visitor by design, and Security Rules are what protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
