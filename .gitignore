# Secrets.
# firebaseServiceAccount.json was committed once and removed in a later
# commit, which does not erase it from history. Rotate that key, and scrub
# history before this repository is ever made public.
movie-review-backend/firebaseServiceAccount.json
movie-review-backend/.env
movie-review-frontend/.env
movie-review-frontend/.env.local
.env
.env.*
!.env.example
!**/.env.example

# Dependencies.
# The frontend's node_modules was not ignored, so every git command walked
# tens of thousands of files and `git status` hung.
node_modules/
**/node_modules/

# Build output. Regenerated by `npm run build`; committing it means every
# build shows up as a diff of minified bundles.
dist/
build/
**/dist/
**/build/

# Editor and OS noise.
.DS_Store
**/.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*

# Coverage and test output.
coverage/
.vitest/

# Firebase CLI deploy caches.
.firebase/
